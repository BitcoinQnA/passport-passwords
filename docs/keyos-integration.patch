diff --git a/os/usb/src/device/implementation.rs b/os/usb/src/device/implementation.rs
--- a/os/usb/src/device/implementation.rs
+++ b/os/usb/src/device/implementation.rs
@@ -57,2 +57,3 @@ struct RegisteredInterface {
     descriptors: Vec<u8>,
+    endpoint_numbers: Vec<u8>,
 }
@@ -316,2 +317,3 @@ impl UsbDeviceServer {
     fn recalculate_config_descriptor(&mut self) {
+        let interface_count = self.interfaces.keys().next_back().map_or(0, |number| number.saturating_add(1));
         self.config_descriptor = vec![
@@ -322,3 +324,3 @@ impl UsbDeviceServer {
             0x00,
-            self.interfaces.len() as u8, // bNumInterfaces
+            interface_count, // bNumInterfaces: highest bInterfaceNumber + 1
             0x01,                        // bConfigurationValue (used to call SetConfiguration)
@@ -341,3 +343,23 @@ impl UsbDeviceServer {
         if self.interfaces.contains_key(&msg.interface_number) {
-            return Err(UsbError::AlreadyRegistered);
+            // Interfaces 0-5 are fixed KeyOS services. Interfaces 6 and above
+            // belong to foreground apps, whose processes can exit without an
+            // opportunity to unregister. Replace those stale registrations so
+            // reopening an app does not leave the host bound to dead endpoints.
+            if msg.interface_number < usb::device::interface_numbers::LOG_USB_SERIAL_DATA + 1 {
+                return Err(UsbError::AlreadyRegistered);
+            }
+
+            log::info!("Replacing app USB interface {}", msg.interface_number);
+            let old = self.interfaces.remove(&msg.interface_number).unwrap();
+            for endpoint_number in old.endpoint_numbers {
+                if let Some(mut endpoint) = self.endpoints.remove(&endpoint_number) {
+                    if let Some(mut read) = endpoint.ongoing_read.take() {
+                        read.set_response(Err(UsbError::HostDisconnected));
+                    }
+                    if let Some(mut write) = endpoint.ongoing_write.take() {
+                        write.msg.set_response(Err(UsbError::HostDisconnected));
+                    }
+                }
+                self.hw.reset_endpoint(endpoint_number as usize);
+            }
         }
@@ -402,3 +424,9 @@ impl UsbDeviceServer {
         }
-        self.interfaces.insert(msg.interface_number, RegisteredInterface { descriptors });
+        self.interfaces.insert(
+            msg.interface_number,
+            RegisteredInterface {
+                descriptors,
+                endpoint_numbers: result.clone(),
+            },
+        );
         Ok(result)
@@ -432,3 +460,5 @@ impl UsbDeviceServer {
         descriptors.extend_from_slice(&msg.capability_functional_descriptors);
-        self.capabilities.push(RegisteredCapability { descriptors });
+        if !self.capabilities.iter().any(|capability| capability.descriptors == descriptors) {
+            self.capabilities.push(RegisteredCapability { descriptors });
+        }
     }

import { AppHeader, Button, ButtonSection, CardColorPicker, IconButton, TextSm,
         BasePage, PageBody, ContentSection, ScrollBody, ConfirmationModal } from "../../compat/widgets.slint";
import { MenuSection, MenuSectionLayout, InfoRow, HLine, ShowMore } from "../../compat/menu.slint";
import { Importance, Palette, Size } from "../../compat/theme.slint";
import { Callbacks } from "../../callbacks.slint";
import { ReleaseRow } from "../../types.slint";
import { Navigate } from "../../gen/navigate.slint";

export component DetailsPage inherits Rectangle {
    property <bool> show-reveal-confirm: false;
    property <bool> password-revealed: false;
    property <string> password-value: "";
    init => {
        password-revealed = false;
        password-value = "";
    }

    BasePage {
        VerticalLayout {
            // Standard AppHeader back, same as the rest of this app and
            // other KeyOS pages. Kept outside ScrollBody so the chevron
            // stays visible while Released to is expanded and scrolled.
            AppHeader {
                title: Callbacks.editing-label != "" ? Callbacks.editing-label : "Password";
                title-color: Palette.content-primary;
                side-padding: Size.sz8;

                IconButton {
                    icon: "chevron-left";
                    size: Size.sz10;
                    icon-size: Size.sz8;
                    importance: Importance.normal;
                    clicked => { Navigate.backward(); }
                }
            }

            PageBody {
                ScrollBody {
                    p-x: Size.zero;
                    p-y: Size.zero;

                    ContentSection {
                        spacing: Size.sz4;

                        MenuSection {
                            title: "Website";
                            MenuSectionLayout {
                                HorizontalLayout {
                                    padding: Size.sz4;
                                    TextSm {
                                        text: Callbacks.editing-origin;
                                        color: Palette.content-primary;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        MenuSection {
                            title: "Username";
                            MenuSectionLayout {
                                HorizontalLayout {
                                    padding: Size.sz4;
                                    TextSm {
                                        text: Callbacks.editing-username;
                                        color: Palette.content-primary;
                                        wrap: no-wrap;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        MenuSection {
                            title: "Password";
                            MenuSectionLayout {
                                VerticalLayout {
                                    padding: Size.sz4;
                                    spacing: Size.sz3;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        if password-revealed: TextSm {
                                            text: "sensitive";
                                            color: Palette.content-negative;
                                        }
                                    }
                                    if !password-revealed: TextSm {
                                        text: "••• hidden •••";
                                        color: Palette.content-tertiary;
                                    }
                                    if password-revealed: TextSm {
                                        text: password-value;
                                        color: Palette.content-primary;
                                        wrap: char-wrap;
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        Button {
                                            label: password-revealed ? "Hide" : "Reveal password";
                                            importance: password-revealed ? Importance.secondary : Importance.negative;
                                            clicked => {
                                                if (password-revealed) {
                                                    password-revealed = false;
                                                    password-value = "";
                                                } else {
                                                    show-reveal-confirm = true;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        MenuSection {
                            title: "Color";
                            MenuSectionLayout {
                                VerticalLayout {
                                    padding: Size.sz4;
                                    CardColorPicker {
                                        selected-index: Callbacks.editing-color;
                                        title: "";
                                        changed(index) => {
                                            Callbacks.editing-color = index;
                                            Callbacks.change-color(Callbacks.editing-uuid, index);
                                        }
                                    }
                                }
                            }
                        }

                        if Callbacks.editing-release-history.length > 0: MenuSection {
                            title: "Released to";
                            MenuSectionLayout {
                                for row[index] in Callbacks.editing-release-history: VerticalLayout {
                                    if index < Callbacks.editing-release-shown: VerticalLayout {
                                        if index > 0: HLine { }
                                        InfoRow {
                                            label: row.date;
                                            label-sub: row.year;
                                            value: row.surface;
                                            value-sub: row.peer;
                                        }
                                    }
                                }
                                if Callbacks.editing-release-has-more: ShowMore {
                                    clicked => { Callbacks.release-show-more(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if show-reveal-confirm: ConfirmationModal {
        icon: "alert";
        title: "Reveal password?";
        text: "The next screen will show the password in plaintext. Only do this where nobody else can see your screen.";
        cancel-button-label: "Cancel";
        confirm-button-label: "Reveal";
        critical: true;

        cancel-clicked => { show-reveal-confirm = false; }

        confirm-clicked => {
            show-reveal-confirm = false;
            password-value = Callbacks.reveal-password(Callbacks.editing-uuid);
            password-revealed = password-value != "";
        }
    }
}

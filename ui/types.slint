/// One "Released to" row on the details page: two lines per column.
@rust-attr(derive(serde::Serialize, serde::Deserialize))
export struct ReleaseRow {
    /// Prime-local day and month, e.g. "28 Nov".
    date: string,
    /// Prime-local year, e.g. "2026".
    year: string,
    /// What asked for the password, e.g. "Chrome extension".
    surface: string,
    /// Name of the paired device it came through, e.g. "Grok Bot".
    peer: string,
}

@rust-attr(derive(serde::Serialize, serde::Deserialize))
export struct StoredCredential {
    uuid: string,
    label: string,
    origin: string,
    /// Host part of `origin` (no scheme/port). Used as a friendlier
    /// fallback title when no `label` is set.
    host: string,
    username: string,
    color: int,
    archived: bool,
    /// Pre-formatted human "5 minutes ago" / "Today 14:32" string. Empty
    /// in the main-list view; only the details page populates this.
    last-used: string,
    /// Newest first.
    release-history: [ReleaseRow],
}

@rust-attr(derive(serde::Serialize, serde::Deserialize))
export struct ApprovalState {
    active: bool,
    title: string,
    action-label: string,
    origin: string,
    username: string,
}
